{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "description": "Default build agent for tile-upgrade-planner-muluna.",
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "primary",
      "temperature": 0.7,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "webfetch": "allow",
        "git *": "allow",
        "git commit *": "allow",
        "git push *": "deny"
      }
    },
    "test": {
      "description": "Runs and diagnoses the headless FUnit suite. Does not edit code.",
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "{file:./prompts/test-runner.txt}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "deny"
      }
    },
    "factorio-docs-agent": {
      "description": "Subagent that answers questions from the Factorio documentation.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "prompt": "{file:./prompts/factorio-docs.txt}",
      "permission": {
        "bash": "allow"
      }
    },
    "factorio-docs": {
      "description": "Primary agent for questions about the Factorio prototype and runtime APIs.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "prompt": "{file:./prompts/factorio-docs.txt}",
      "temperature": 0.1,
      "permission": {
        "bash": "allow",
        "edit": "deny"
      }
    },
    "lua-docs": {
      "description": "Primary agent for questions about Lua 5.2 semantics and the standard library.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "prompt": "{file:./prompts/lua-docs.txt}",
      "temperature": 0.1,
      "permission": {
        "bash": "allow",
        "edit": "deny"
      }
    }
  }
}
